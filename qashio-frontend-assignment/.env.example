# Copy to .env.local and adjust.
#
# The browser always calls this app's /api/* routes. When BACKEND_API_URL is set,
# the Next.js server forwards them to the NestJS API (/api/transactions ->
# $BACKEND_API_URL/transactions). When it is empty, the built-in mock API
# (data/db.json) answers instead.
#
# This app runs on :3000, NestJS on :4000 (with the global /api prefix).
# Docker: BACKEND_API_URL=http://qashio-api:4000/api
BACKEND_API_URL=http://localhost:4000/api

# If NestJS is set but unreachable, the mock API answers (and NestJS is retried
# after 30s). Set to false to return 502 errors instead of mock data.
BACKEND_FALLBACK=true
