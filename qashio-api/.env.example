NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

BODY_LIMIT=1mb

# PostgreSQL - local development example only
DATABASE_URL=postgresql://postgres:password@localhost:5432/qashio_points
# Connection pool size
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Demo account created by `npm run seed` (development only)
SEED_DEMO_EMAIL=demo@qashio.com
SEED_DEMO_PASSWORD=Demo@12345

THROTTLE_TTL_MS=
THROTTLE_LIMIT=

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=qashio-api
KAFKA_GROUP_ID=qashio-api

# Transactional outbox (relay, retries, health check, cleanup)
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=60000
# Must be >= the Kafka topic retention, or a replayed message could be processed twice
OUTBOX_RETENTION_DAYS=7
OUTBOX_STUCK_THRESHOLD_MIN=5
# Redeliveries of a failing message before the budget consumer gives up on it
CONSUMER_MAX_RETRIES=5
